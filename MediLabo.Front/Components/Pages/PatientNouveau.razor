@page "/patients/nouveau"
@inject PatientsClient Client
@inject NavigationManager Navigation

<PageTitle>Nouveau patient</PageTitle>

<h1>Nouveau patient</h1>
@if (refuse)
{
    <p>Le service Patients a refusé l'enregistrement. Vérifiez les informations saisies.</p>
}

<EditForm Model="Patient" FormName="ajout" OnValidSubmit="Enregistrer">
    <DataAnnotationsValidator />

    <PatientFormulaire Patient="Patient" />

    <button type="submit">Enregistrer</button>
</EditForm>


@code {
    [SupplyParameterFromForm]
    private PatientInputDto? Patient { get; set; }

    private bool refuse;

    protected override void OnInitialized()
    {
        Patient ??= new();
    }

    private async Task Enregistrer()
    {
        PatientDto? nouveau = await Client.CreateAsync(Patient!);

        if (nouveau is null)
        {
            refuse = true;
            return;
        }

        Navigation.NavigateTo($"/patients/{nouveau.Id}");
    }
}