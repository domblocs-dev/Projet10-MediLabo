@page "/"
@inject PatientsClient Client

<PageTitle>Patients</PageTitle>

<h1>Patients</h1>
<p><a href="/patients/nouveau">Nouveau patient</a></p>
<table>
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Date de naissance</th>
            <th>Genre</th>
        </tr>
    </thead>
    <tbody>
        @foreach (PatientDto patient in patients)
        {
            <tr>
                <td><a href="/patients/@patient.Id">@patient.Nom</a></td>
                <td>@patient.Prenom</td>
                <td>@patient.DateNaissance.ToString("dd/MM/yyyy")</td>
                <td>@patient.Genre</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<PatientDto> patients = [];

    protected override async Task OnInitializedAsync()
    {
        patients = await Client.GetAllAsync();
    }
}